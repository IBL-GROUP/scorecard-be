# Docker Environment Configuration
# This file is used when running with docker-compose
# Copy this to .env.docker.local and customize as needed

# Server Configuration
NODE_ENV=production
PORT=3014
API_PREFIX=/api/v1

# Database Configuration (Docker)
# Note: DB_HOST is set to the external database IP
DB_HOST=35.216.155.219
DB_PORT=5432
DB_NAME=primary_secondary_sales_db
DB_USER=primarySecSales
DB_PASSWORD='Primary###Sec@@$$753'
DB_DIALECT=postgres
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=10000
DB_QUERY_CONCURRENCY=8
DB_SLOW_QUERY_MS=5000
DB_STATEMENT_TIMEOUT_MS=120000
DB_IDLE_TRANSACTION_TIMEOUT_MS=120000

# JWT Configuration
JWT_ACCESS_SECRET=-esMtaVDqrc00PBGwM7rFEaBJJwydpngit90kKGc45WOnjg_uddRLoR73TxIn0XD
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# RSA Keys for JWT (generated by npm run generate-keys)
JWT_PRIVATE_KEY_PATH=./keys/private_key.pem
JWT_PUBLIC_KEY_PATH=./keys/public_key.pem

# CORS Configuration
CORS_ORIGIN=http://192.168.130.72:3013,http://localhost:3013
CORS_CREDENTIALS=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Secondary Database — RD stock (franchise schema).
# Without these the RD Status endpoints return 503 "Secondary database is not
# configured". Host/port are intentionally blank: they fall back to the DB_*
# values above, which point at the same server.
DB2_HOST=
DB2_PORT=
DB2_NAME=franchise_db
DB2_USER=mlData
DB2_PASSWORD=mldata_123
DB2_SCHEMA=franchise,public
