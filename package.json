{
  "name": "scorecard-backend",
  "version": "1.0.0",
  "description": "Backend server for SupplyChain Pulse (Scorecard) with PostgreSQL and Sequelize",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "generate-models": "node scripts/generate-models.js",
    "start:v2": "node v2/start.js",
    "dev:v2": "nodemon v2/start.js",
    "test:v2": "node --test v2/tests/",
    "smoke:v2": "node v2/scripts/smoke.mjs"
  },
  "keywords": [
    "express",
    "postgresql",
    "sequelize"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-auto": "^0.8.8"
  }
}
